# ==============================================================================
# 1. HỆ THỐNG, MODEL & MEDIAMTX
# ==============================================================================
MODEL_PATH=../../models/vehicle_n_best.pt
DEVICE=cuda:0
# DEMO_MODE=1 rút ngắn thời gian xác nhận sự kiện (30s/+20s/+90s thay vì 180s/+120s/+900s)
DEMO_MODE=0
PORT=28080
WS_PUSH_HZ=5
MAX_CAMERAS=8
MEDIAMTX_BIN=mediamtx/mediamtx
MEDIAMTX_CONFIG=mediamtx/mediamtx.yml
MEDIAMTX_RTSP_PORT=28554
MEDIAMTX_WEBRTC_PORT=28889
MEDIAMTX_ICE_TCP_PORT=28189
MEDIAMTX_API_PORT=29997

# ==============================================================================
# 2. PHƯƠNG ÁN 1: DETECTOR, TRỌNG SỐ, TRACKER & ZONE TIME (T50 / D85)
# ==============================================================================
# Kích thước đầu vào YOLO, ngưỡng tin cậy tối thiểu để giữ bbox, ngưỡng NMS IoU
YOLO_IMGSZ=640
YOLO_CONF=0.15
YOLO_IOU=0.5
# Phần trăm mở rộng vùng bao Poly Zone khi cắt ảnh suy luận YOLO (0.10 = +10% lề)
ROI_PADDING=0.10

# Trọng số quy đổi mật độ W_total = sum(số xe * trọng số)
WEIGHT_2W=1.0
WEIGHT_CAR=3.0
WEIGHT_HEAVY=6.0

# ByteTrack: thời gian giữ track khi mất dấu (giây), conf kích hoạt track mới, ngưỡng khớp IoU
TRACK_BUFFER_S=2.5
TRACK_ACTIVATION_CONF=0.45
TRACK_MATCH_THRESH=0.8

# Zone Time: cửa sổ trượt T50 (giây), thời gian lưu tối thiểu để tính D85 (giây)
ZONE_WINDOW_S=30.0
ZONE_MIN_DWELL_S=2.0
# Tỷ lệ chiều dài quãng đường tối thiểu trong zone để tính mẫu T50 hợp lệ
ZONE_MIN_TRAVEL_RATIO=0.45
# Số mẫu tối thiểu để hiển thị T50 (xe đã qua zone) và D85 (xe đang kẹt trong zone)
ZONE_MIN_COMPLETED_SAMPLES=2
ZONE_MIN_ACTIVE_SAMPLES=2
# Thời gian chờ tối đa trước khi xóa track đã rời/mất dấu khỏi zone (giây)
ZONE_LOST_TIMEOUT_S=1.0

# ==============================================================================
# 3. PHƯƠNG ÁN 2: MOG2 ĐỘ PHỦ & FARNEBACK DÒNG CHẢY (V_flow)
# ==============================================================================
# Mở rộng vùng đo O_vis/V_flow dọc theo trục đường thêm % ở cả 2 đầu trên/dưới (0.20 = +20% mỗi đầu), giữ nguyên bề ngang
FLOW_ZONE_EXTEND_RATIO=0.20
# Tốc độ học nền MOG2 khi xe còn đang chạy bình thường (sẽ đóng băng = 0 khi xe dừng lâu)
MOG2_LR_NORMAL=0.002
# Lọc nhiễu chuyển động nền (px/s): dưới mức này coi như đứng yên
FLOW_NOISE_PX=0.8
# Ngưỡng dòng chảy (px/s trên khung 320x180)
V_STALL=6.0
V_GRIDLOCK_MAX=15.0
V_CONGESTED_MACRO=14.0
V_CONGESTED_MAX=18.0
V_CLEAR_MIN=10.0

# ==============================================================================
# 4. BỘ PHÂN LOẠI V2 (CLASSIFIER): O_vis + FLOW + T50/D85
#    (Đã cân chỉnh cho Poly Zone 18–22m; bỏ ngưỡng cứng W_*)
# ==============================================================================
# Cổng xác nhận có phương tiện thật (chống nhiễu đèn pha đêm mưa)
W_SANITY_MIN=3.0

# Ngưỡng độ phủ O_vis (0..1)
O_CLEAR=0.40
O_CONGESTED=0.70
O_GRIDLOCK=0.85

# Ngưỡng thời gian T50 / D85 (giây) ranh giới CLEAR -> CONGESTED
CONGESTED_T50_4W_S=5.5
CONGESTED_D85_4W_S=6.5
CONGESTED_T50_2W_S=4.5
CONGESTED_D85_2W_S=5.0

# Ngưỡng thời gian T50 / D85 (giây) ranh giới CONGESTED -> GRIDLOCKED
GRIDLOCK_T50_4W_S=16.0
GRIDLOCK_D85_4W_S=20.0
GRIDLOCK_T50_2W_S=13.5
GRIDLOCK_D85_2W_S=17.0

# ==============================================================================
# 5. OCCLUSION SHIELD & STATE MACHINE (CHỐNG RUNG / CHU KỲ SỰ KIỆN 3p -> 5p -> 15p)
# ==============================================================================
# Tỷ lệ diện tích xe buýt/tải che zone (> 45%) hoặc tụt số bbox đột ngột (> 65%) khi O_vis > 72% -> HOLD
HEAVY_AREA_RATIO=0.45
BBOX_DROP_RATIO=0.65
OCC_O_VIS=0.72
# Giữ trạng thái HOLD tối đa bao nhiêu giây trước khi chuyển sang UNKNOWN
OCC_HOLD_MAX_S=40.0

# Cửa sổ làm mượt trạng thái hiển thị (giây) và timeout mất luồng camera (giây)
SMOOTH_WINDOW_S=5.0
STREAM_TIMEOUT_S=5.0
# Chu kỳ xác nhận & nhắc lại sự kiện (bỏ trống sẽ tự lấy theo DEMO_MODE:
#   DEMO_MODE=0 -> RED_LIGHT_HOLD=90s, CONFIRM_STATE=180s (3p), FOLLOWUP=+120s (5p), PERIODIC=+900s (15p)
#   DEMO_MODE=1 -> RED_LIGHT_HOLD=15s, CONFIRM_STATE=30s, FOLLOWUP=+20s, PERIODIC=+90s)
# RED_LIGHT_HOLD_S=90.0
# CONFIRM_STATE_S=180.0
# FOLLOWUP_AFTER_CONFIRM_S=120.0
# PERIODIC_REMINDER_S=900.0
# Cho phép dao động ngắn (giây) mà không reset bộ đếm; thời gian thoát về CLEAR
PERSISTENCE_TOLERANCE_S=5.0
EXIT_CLEAR_S=10.0

# ==============================================================================
# 1. HỆ THỐNG, MODEL & MEDIAMTX
# ==============================================================================
MODEL_PATH=../../models/vehicle_n_best.pt
DEVICE=cuda:0
# DEMO_MODE=1 rút ngắn thời gian xác nhận sự kiện (15s/20s/30s thay vì 60s/90s/120s)
DEMO_MODE=0
PORT=28080
WS_PUSH_HZ=5
MAX_CAMERAS=8
MEDIAMTX_BIN=mediamtx/mediamtx
MEDIAMTX_CONFIG=mediamtx/mediamtx.yml
MEDIAMTX_RTSP_PORT=28554
MEDIAMTX_WEBRTC_PORT=28889
MEDIAMTX_ICE_TCP_PORT=28189
MEDIAMTX_API_PORT=29997

# ==============================================================================
# 2. PHƯƠNG ÁN 1: DETECTOR, TRỌNG SỐ, TRACKER & ZONE TIME (T50 / D85)
# ==============================================================================
# Kích thước đầu vào YOLO, ngưỡng tin cậy tối thiểu để giữ bbox, ngưỡng NMS IoU
YOLO_IMGSZ=640
YOLO_CONF=0.15
YOLO_IOU=0.5
# Phần trăm mở rộng vùng bao Poly Zone khi cắt ảnh suy luận YOLO (0.10 = +10% lề)
ROI_PADDING=0.10

# Trọng số quy đổi mật độ W_total = sum(số xe * trọng số)
WEIGHT_2W=1.0
WEIGHT_CAR=3.0
WEIGHT_HEAVY=6.0

# ByteTrack: thời gian giữ track khi mất dấu (giây), conf kích hoạt track mới, ngưỡng khớp IoU
TRACK_BUFFER_S=2.5
TRACK_ACTIVATION_CONF=0.45
TRACK_MATCH_THRESH=0.8

# Zone Time: cửa sổ trượt T50 (giây), thời gian lưu tối thiểu để tính D85 (giây)
ZONE_WINDOW_S=15.0
ZONE_MIN_DWELL_S=1.5
# Tỷ lệ chiều dài quãng đường tối thiểu trong zone để tính mẫu T50 hợp lệ
ZONE_MIN_TRAVEL_RATIO=0.45
# Số mẫu tối thiểu để hiển thị T50 (xe đã qua zone) và D85 (xe đang kẹt trong zone)
ZONE_MIN_COMPLETED_SAMPLES=3
ZONE_MIN_ACTIVE_SAMPLES=2
# Thời gian chờ tối đa trước khi xóa track đã rời/mất dấu khỏi zone (giây)
ZONE_LOST_TIMEOUT_S=1.0

# ==============================================================================
# 3. PHƯƠNG ÁN 2: MOG2 ĐỘ PHỦ & FARNEBACK DÒNG CHẢY (V_flow)
# ==============================================================================
# Tốc độ học nền MOG2 khi xe còn đang chạy bình thường (sẽ đóng băng = 0 khi xe dừng lâu)
MOG2_LR_NORMAL=0.005
# Lọc nhiễu chuyển động nền (px/s): dưới mức này coi như đứng yên
FLOW_NOISE_PX=0.8
# Ngưỡng dòng chảy đứng im (px/s) và dòng chảy thoát nhanh (px/s)
V_STALL=1.0
V_CLEAR=6.0

# ==============================================================================
# 4. BỘ PHÂN LOẠI (CLASSIFIER): NGƯỠNG MẬT ĐỘ W, ĐỘ PHỦ O_vis & T50/D85
# ==============================================================================
# Dưới cả W_CLEAR và O_CLEAR -> kết luận ngay CLEAR
W_CLEAR=12.0
O_CLEAR=0.35

# Ngưỡng mật độ W và độ phủ O_vis (0..1) để kích hoạt nhánh CONGESTED / GRIDLOCKED
W_CONGESTED=15.0
O_CONGESTED=0.45
W_GRIDLOCK=24.0
O_GRIDLOCK=0.65
# Ngưỡng độ phủ dự phòng (macro_ok) ở nhánh GRIDLOCKED khi dòng chảy chưa về <= V_STALL
O_MACRO_STALL=0.70

# Nhánh Macro Rescue: cứu nguy khi kẹt đặc làm đứt ByteTrack ID (T50/D85 bị None)
W_RESCUE=18.0
O_RESCUE=0.75

# Ngưỡng thời gian T50 / D85 (giây) cho CONGESTED (chỉ cần 1 trong các điều kiện thỏa khi đủ mật độ)
CONGESTED_T50_4W_S=3.0
CONGESTED_D85_4W_S=5.0
CONGESTED_T50_2W_S=3.0
CONGESTED_D85_2W_S=4.5

# Ngưỡng thời gian T50 / D85 (giây) cho GRIDLOCKED
GRIDLOCK_T50_4W_S=7.0
GRIDLOCK_D85_4W_S=10.0
GRIDLOCK_T50_2W_S=5.0
GRIDLOCK_D85_2W_S=8.0
# Nhánh thuần xe máy (khi số xe 4B trong zone < 2)
GRIDLOCK_T50_2W_ONLY_S=5.5
GRIDLOCK_D85_2W_ONLY_S=8.5

# ==============================================================================
# 5. OCCLUSION SHIELD & STATE MACHINE (CHỐNG RUNG / CHỐNG CHE KHUẤT)
# ==============================================================================
# Tỷ lệ diện tích xe buýt/tải che zone (> 35%) hoặc tụt số bbox đột ngột (> 60%) khi O_vis > 70% -> HOLD
HEAVY_AREA_RATIO=0.35
BBOX_DROP_RATIO=0.60
OCC_O_VIS=0.70
# Giữ trạng thái HOLD tối đa bao nhiêu giây trước khi chuyển sang UNKNOWN
OCC_HOLD_MAX_S=30.0

# Cửa sổ làm mượt trạng thái hiển thị (giây) và timeout mất luồng camera (giây)
SMOOTH_WINDOW_S=5.0
STREAM_TIMEOUT_S=5.0
# Thời gian duy trì liên tục để ghi nhận sự kiện Confirmed (nếu bỏ trống sẽ theo DEMO_MODE)
# CONFIRM_CONGESTED_S=60.0
# CONFIRM_CONGESTED_LIGHT_S=90.0
# CONFIRM_GRIDLOCK_S=120.0
# Cho phép dao động ngắn (giây) mà không reset bộ đếm Confirmed; thời gian thoát về CLEAR; cooldown log sự kiện
PERSISTENCE_TOLERANCE_S=5.0
EXIT_CLEAR_S=15.0
COOLDOWN_S=60.0

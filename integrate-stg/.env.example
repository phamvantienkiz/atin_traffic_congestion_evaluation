# ==============================================================================
# 1. KẾT NỐI MQTT BROKER & STORAGE AIOC STAGING (C01, C05)
# - Chế độ mặc định [A]: Server aiot tự kết nối trực tiếp tới Staging.
# - Chế độ tạm [B]: Khi aiot bị chặn outbound 443, comment khối [A] và mở khối [B]
#   (đồng thời mở SSH tunnel trên laptop: ssh -N -R 18443:aioc-stg.atin.vn:443 tts@192.168.1.170).
#   Khi aiot thông mạng lại với Staging: comment khối [B] và mở lại khối [A].
# ==============================================================================

# --- [A] KẾT NỐI TRỰC TIẾP TỪ SERVER (MẶC ĐỊNH) ---
MQTT_HOST=aioc-stg.atin.vn
MQTT_PORT=443
STORAGE_UPLOAD_URL=https://aioc-stg.atin.vn/storage/upload/file
MQTT_TLS_INSECURE=false
STAGING_HOST_HEADER=

# --- [B] CHẠY TẠM QUA SSH REMOTE TUNNEL TỪ LAPTOP ---
# MQTT_HOST=127.0.0.1
# MQTT_PORT=18443
# STORAGE_UPLOAD_URL=https://127.0.0.1:18443/storage/upload/file
# MQTT_TLS_INSECURE=true
# STAGING_HOST_HEADER=aioc-stg.atin.vn

MQTT_WS_PATH=/mqtt
MQTT_USER=atin
MQTT_PASS=your_mqtt_password_here
# Mỗi tiến trình chạy song song phải có client_id duy nhất; CẤM bắt đầu bằng vms_staging_backend
MQTT_CLIENT_ID=ai_edge_congestion_junction_01
MQTT_KEEPALIVE=30

# ==============================================================================
# 2. PHẠM VI TỔ CHỨC, KHU VỰC & CAMERA MỤC TIÊU (C02, C03)
# - Chạy scripts/step1_probe_camera.py để lấy TARGET_CAMERA_ID, ORGANIZATION_ID, ZONE_ID
# ==============================================================================
ORGANIZATION_ID=0
ZONE_ID=0
TARGET_CAMERA_CODE=camera_junction
TARGET_CAMERA_ID=
FALLBACK_RTSP_URL=rtsp://192.168.1.198:28537/tshtest
# Ghi đè RTSP URL nếu muốn trỏ vào luồng sub-stream độ phân giải thấp (vd 1280x720 / 640x360) để giảm độ trễ decode
RTSP_URL_OVERRIDE=

# ==============================================================================
# 3. CHẾ ĐỘ ĐỊNH TUYẾN MODULE (Option B mặc định cho camera_junction)
# - BBOX_AI_MODULE: Phải khớp module đang bật trên Junction Camera (PLATE)
# - EVENT_PUBLISH_MODE:
#     NONE             -> Chỉ log sự kiện xác nhận ở local (an toàn nhất khi test BBox/HUD)
#     PLATE            -> Upload ảnh + gửi qua smart_vms/ai_events/PLATE (Option B tạm)
#     ZONE             -> Gửi qua smart_vms/ai_events/ZONE (nếu đã bật ZONE trên camera)
#     CROWD_DETECTION  -> Gửi qua smart_vms/ai_events/CROWD_DETECTION (nếu đã bật)
# ==============================================================================
BBOX_AI_MODULE=PLATE
EVENT_PUBLISH_MODE=NONE
STORAGE_CATEGORY=plate

# ==============================================================================
# 4. THAM SỐ LÕI AI TỪ poc/backend/ai (C07, C08, C09)
# ==============================================================================
MODEL_PATH=models/vehicle_n_best.pt
DEVICE=cuda:0
DEMO_MODE=0
MOG2_LR_NORMAL=0.002
O_CLEAR=0.40
O_CONGESTED=0.70
O_GRIDLOCK=0.85
# Ngưỡng dòng chảy & hồi phục trạng thái (chống báo giả khi O_vis cao nhưng xe vẫn thoát nhanh)
V_CONGESTED_MACRO=14.0
V_CONGESTED_MAX=18.0
EXIT_CLEAR_S=10.0

# FPS đọc & infer tối đa (mặc định 25.0 FPS để bám sát luồng video WebRTC; BBox được publish ngay sau mỗi frame)
AI_TARGET_FPS=25.0
# Backend giải mã RTSP: opencv (khuyên dùng cho go2rtc/1.9.15 trên Staging, đã tối ưu nobuffer + INTER_LINEAR) | auto (FFmpeg CUDA/CUVID cho RTSP gửi đủ SPS/PPS)
RTSP_BACKEND=opencv
# Hạ ngưỡng kích hoạt ByteTrack từ 0.45 xuống 0.25 để xe vừa vào vùng là hiện BBox ngay frame đầu tiên
TRACK_ACTIVATION_CONF=0.25
# Nhịp gửi BBox fallback khi chưa có frame mới (0.1s = 10 FPS để tránh auto-fade sau 0.35s)
BBOX_PUBLISH_INTERVAL=0.1
# FORCE_LOCAL_ROI=false: Nhận polyzone từ Web STG (hot-reload C03); nếu Web chưa có vùng thì tự fallback về FALLBACK_ROI_POINTS
FORCE_LOCAL_ROI=false
ALLOW_FALLBACK_ROI=true
FALLBACK_ROI_POINTS=[{"x":0.0247,"y":0.5172},{"x":0.4374,"y":0.3009},{"x":0.8836,"y":0.3574},{"x":0.9065,"y":0.884}]
